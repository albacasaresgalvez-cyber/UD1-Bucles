Algoritmo ejercicio12
	Definir h, m, s  Como Entero
	Definir t Como Caracter
	t<- "a"
	Escribir "Introduce un espacio que inicie el cronómetro"
	Leer t
	Si t = " " Entonces
		Para h<- 0 Hasta 23 Hacer
			Para m<- 0 Hasta 59 Hacer
				Para s<- 0 Hasta 59 Hacer
					Borrar Pantalla
					Escribir h ":", m ":", s
					Esperar 1 Segundo
				Fin Para
			Fin Para
		Fin Para
	FinSi
FinAlgoritmo