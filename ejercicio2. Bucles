Algoritmo ejercicio2
	Definir n, media, suma Como Real
	Definir cantidad Como Entero
	suma<- 0
	cantidad<- 0
	Escribir "Introduzca un número (0 para terminar):"
	Leer n
	Mientras n <> 0 Hacer
		cantidad<- cantidad + 1
		suma<- suma + n
		Escribir "Introduzca un número ( 0 para terminar):"
		Leer n
	Fin Mientras
		Si n = 0 Entonces
			media<- suma / cantidad
			Escribir "Suma: " suma
			Escribir "Cantidad: " cantidad
			Escribir "Media: " media
		SiNo
			Escribir " No has introducido el numero adecuado"
		Fin Si
FinAlgoritmo
