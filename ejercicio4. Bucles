Algoritmo ejercicio4
	Definir letra Como Caracter
	Repetir
		Escribir "Pulse una letra (espacio para terminar)"
		Leer letra
		Si letra <> " " Entonces
			letra<- Minusculas(letra)
			Si letra = "a" o letra = "e" o letra = "i" o letra = "o" o letra = "u" Entonces
				Escribir "Vocal"
			SiNo
			    Escribir "No Vocal"
			FinSi
		FinSi
	Hasta Que letra = " "
FinAlgoritmo
